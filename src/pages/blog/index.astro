---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b, 'ru'));

function slugify(value: string) {
  return value.toLowerCase().trim().replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-+|-+$/g, '');
}

function plainText(value: string) {
  return value.replace(/^#{1,6}\s+/gm, '').replace(/[`*_>[\]]/g, '').replace(/\[[^\]]+\]\([^)]*\)/g, '').replace(/\s+/g, ' ').trim();
}

const searchDocuments = posts.flatMap((post) => {
  const postUrl = `/blog/${post.id.replace(/\.md$/, '')}/`;
  const sections = post.body.split(/\n(?=#{1,3}\s+)/);
  return sections.map((section, index) => {
    const heading = section.match(/^#{1,3}\s+(.+)$/m)?.[1];
    const sectionTitle = heading || (index === 0 ? 'Введение' : 'Фрагмент статьи');
    return {
      title: post.data.title,
      section: sectionTitle,
      excerpt: plainText(section).slice(0, 180),
      url: heading ? `${postUrl}#${slugify(heading)}` : postUrl,
      searchable: `${post.data.title} ${post.data.description} ${post.data.tags.join(' ')} ${plainText(section)}`,
    };
  });
});
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Блог Евгения К. о DevOps, инфраструктуре и инженерных практиках.">
    <title>Блог · Евгений К.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body class="blog-page">
    <main class="blog-shell">
      <header class="blog-header">
        <a class="back-link" href="/">← На главную</a>
        <p class="section-number">Блог / DevOps</p>
        <h1>Заметки<br><em>и разборы.</em></h1>
        <p>Практический опыт, инструменты и наблюдения о надёжной инфраструктуре.</p>
      </header>

      <div class="blog-search">
        <label class="search-label" for="article-search">Поиск по статьям</label>
        <div class="search-input-wrap">
          <span aria-hidden="true">⌕</span>
          <input id="article-search" type="search" placeholder="Например: systemd, Kubernetes, SSH…" autocomplete="off" aria-describedby="search-hint">
          <kbd>Esc</kbd>
        </div>
        <p class="search-hint" id="search-hint">Поиск по названиям, тегам и содержимому статей.</p>
        <ul class="search-results" aria-live="polite" hidden></ul>
      </div>

      <div class="tag-filter" aria-label="Фильтр публикаций по тегам">
        <span class="tag-filter-label">Темы</span>
        <div class="tag-filter-buttons">
          <button class="tag-filter-button is-active" type="button" data-tag="all" aria-pressed="true">Все</button>
          {tags.map((tag) => <button class="tag-filter-button" type="button" data-tag={tag} aria-pressed="false">{tag}</button>)}
        </div>
      </div>

      <section class="blog-grid" aria-label="Публикации">
        {posts.map((post) => {
          const postUrl = `/blog/${post.id.replace(/\.md$/, '')}/`;
          const published = post.data.pubDate.toLocaleDateString('ru-RU', {
            day: 'numeric', month: 'long', year: 'numeric',
          });
          const image = post.data.youtubeId
            ? `https://i.ytimg.com/vi/${post.data.youtubeId}/hqdefault.jpg`
            : undefined;

          return (
            <article class="blog-card" data-tags={post.data.tags.join('|')}>
              <a class="blog-card-image" href={postUrl} aria-label={`Открыть: ${post.data.title}`}>
                {image ? <img src={image} alt="" loading="lazy" /> : <span>DEV<br />OPS</span>}
              </a>
              <div class="blog-card-body">
                <time datetime={post.data.pubDate.toISOString()}>{published}</time>
                <h2><a href={postUrl}>{post.data.title}</a></h2>
                <p>{post.data.description}</p>
                {post.data.tags.length > 0 && <div class="post-tags">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>}
                <a class="read-more" href={postUrl}>Читать дальше <span>→</span></a>
              </div>
            </article>
          );
        })}
      </section>
      <p class="filter-empty" hidden>По выбранным тегам публикаций пока нет.</p>

      <footer><span>© 2026 Евгений К.</span><a href="/">ek-deus.github.io</a></footer>
    </main>
    <script define:vars={{ searchDocuments }}>
      const searchInput = document.querySelector('#article-search');
      const searchResults = document.querySelector('.search-results');
      const normalize = (value) => value.toLocaleLowerCase('ru-RU').replace(/ё/g, 'е');

      function showSearchResults() {
        const query = normalize(searchInput.value).trim();
        if (query.length < 2) {
          searchResults.hidden = true;
          searchResults.replaceChildren();
          return;
        }
        const terms = query.split(/\s+/);
        const matches = searchDocuments
          .map((document) => {
            const content = normalize(document.searchable);
            if (!terms.every((term) => content.includes(term))) return null;
            const score = terms.reduce((total, term) => total
              + (normalize(document.title).includes(term) ? 12 : 0)
              + (normalize(document.section).includes(term) ? 7 : 0)
              + (content.split(term).length - 1), 0);
            return { ...document, score };
          })
          .filter(Boolean)
          .sort((a, b) => b.score - a.score)
          .slice(0, 6);

        searchResults.replaceChildren();
        if (matches.length === 0) {
          const item = document.createElement('li');
          item.className = 'search-no-results';
          item.textContent = 'Ничего не найдено. Попробуйте другой запрос.';
          searchResults.append(item);
        } else {
          matches.forEach((match) => {
            const item = document.createElement('li');
            const link = document.createElement('a');
            link.href = match.url;
            const title = document.createElement('strong');
            title.textContent = match.title;
            const section = document.createElement('span');
            section.textContent = match.section;
            const excerpt = document.createElement('small');
            excerpt.textContent = match.excerpt;
            link.append(title, section, excerpt);
            item.append(link);
            searchResults.append(item);
          });
        }
        searchResults.hidden = false;
      }

      searchInput.addEventListener('input', showSearchResults);
      searchInput.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          searchInput.value = '';
          showSearchResults();
          searchInput.blur();
        }
        if (event.key === 'Enter') searchResults.querySelector('a')?.click();
      });

      const buttons = Array.from(document.querySelectorAll('.tag-filter-button'));
      const cards = Array.from(document.querySelectorAll('.blog-card'));
      const empty = document.querySelector('.filter-empty');
      const selected = new Set();

      if (location.hash.startsWith('#tag-')) {
        const tagFromHash = decodeURIComponent(location.hash.slice(5));
        if (buttons.some((button) => button.dataset.tag === tagFromHash)) selected.add(tagFromHash);
      }

      function updateFilter() {
        const activeTags = [...selected];
        let visible = 0;
        cards.forEach((card) => {
          const cardTags = (card.dataset.tags || '').split('|').filter(Boolean);
          const show = activeTags.length === 0 || activeTags.every((tag) => cardTags.includes(tag));
          card.hidden = !show;
          if (show) visible += 1;
        });
        empty.hidden = visible !== 0;
        buttons.forEach((button) => {
          const all = button.dataset.tag === 'all';
          const active = all ? activeTags.length === 0 : selected.has(button.dataset.tag);
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', String(active));
        });
      }

      buttons.forEach((button) => button.addEventListener('click', () => {
        const tag = button.dataset.tag;
        if (tag === 'all') selected.clear();
        else selected.has(tag) ? selected.delete(tag) : selected.add(tag);
        updateFilter();
      }));
      updateFilter();
    </script>
  </body>
</html>
